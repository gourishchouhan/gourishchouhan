---
import { portfolio } from "../data/portfolio";
---
<button class="info-button location-button" id="earth-control" type="button" aria-expanded="false"
  aria-label={`Location: ${portfolio.location}. Activate to open the globe. Drag or use arrow keys to rotate.`}>
  <span>Location</span>
  <span class="info-panel location-panel" aria-hidden="true">
    <span class="earth-visual">
      <img class="earth-model" src="/cartoon-earth-india.png" alt="" width="384" height="384" />
      <canvas width="144" height="144" hidden></canvas>
    </span>
    <span class="location-copy">Based in {portfolio.location}</span>
  </span>
</button>
<style>
  #earth-control[aria-expanded=true] .location-panel {opacity:1;transform:translate(-50%,0);pointer-events:auto;}
  .earth-visual {width:min(12rem,42vw);height:auto;aspect-ratio:1;}
  .location-panel {touch-action:none;user-select:none;}
  .location-panel canvas {width:100%;height:100%;cursor:grab;}
  .location-panel canvas:active {cursor:grabbing;}
</style>
<script>
  const button = document.querySelector<HTMLButtonElement>("#earth-control")!;
  const canvas = button.querySelector("canvas")!;
  let ready: Promise<((key:string)=>void) | undefined> | undefined;
  function load() {
    return ready ??= import("./globe").then(async ({mountEarth}) => {
      const rotate = await mountEarth(canvas);
      button.querySelector("img")!.hidden = true;
      canvas.hidden = false;
      return rotate;
    }).catch(() => undefined);
  }
  button.addEventListener("pointerenter", load);
  button.addEventListener("focus", load);
  const expand=(open:boolean)=>button.setAttribute("aria-expanded",String(open));
  button.addEventListener("click", event=>{
    load();
    if(event.target!==canvas)expand(button.getAttribute("aria-expanded")!=="true");
  });
  button.addEventListener("blur",()=>expand(false));
  button.addEventListener("keydown",event=>{
    if(event.key==="Escape")expand(false);
    if(!["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"].includes(event.key))return;
    event.preventDefault();expand(true);
    load().then(rotate=>rotate?.(event.key));
  });
</script>
