---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Gourish Chouhan"
  description="A sleek personal portfolio for Gourish Chouhan."
>
  <div class="spotlight-beam" aria-hidden="true"></div>
  <button class="light-switch" id="light-switch" type="button" aria-label="Reveal the detective" aria-pressed="false" aria-controls="resume-trigger" hidden>
    <svg class="hanging-light" viewBox="0 0 112 150" fill="none" aria-hidden="true">
      <path d="M44 0V42" stroke="#aaa" stroke-width="2" />
      <circle class="bulb-glass" cx="44" cy="83" r="14" />
      <path d="M34 55V44Q34 39 39 39H49Q54 39 54 44V55C70 60 80 70 80 84H8C8 70 18 60 34 55Z" fill="#242424" stroke="#888" stroke-width="1" />
      <g class="pull-cord">
        <path d="M89 0V111" stroke="currentColor" stroke-width="1.5" />
        <path d="M89 110L84 122Q89 128 94 122Z" fill="currentColor" />
      </g>
    </svg>
  </button>
  <main class="name-screen" aria-labelledby="page-title">
    <div class="intro-content">
      <h1 id="page-title">Gourish Chouhan</h1>

      <div class="intro-actions" aria-label="More about Gourish">
        <button class="info-button" type="button" aria-label="Job status: Unemployed">
          <span>Job</span>
          <span class="info-panel job-panel" aria-hidden="true">
            <span class="job-visual">
              <img class="job-image" src="/job-detective.webp" alt="" width="384" height="384" decoding="async" />
            </span>
            <span class="job-copy">Unemployed</span>
          </span>
        </button>

        <button class="info-button location-button" type="button" aria-label="Location: India">
          <span>Location</span>
          <span class="info-panel location-panel" aria-hidden="true">
            <span class="earth-visual">
              <img
                class="earth-model"
                src="/cartoon-earth-india.png"
                alt=""
                width="384"
                height="384"
              />
            </span>
            <span class="location-copy">Based in India</span>
          </span>
        </button>
      </div>
    </div>
  </main>
  <a
    class="resume-link"
    href="/Resume.pdf"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Open my resume (PDF, opens in a new tab)"
    id="resume-trigger"
  >
    <img
      class="resume-character"
      src="/resume-detective-upper.webp"
      alt=""
      width="448"
      height="560"
      decoding="async"
    />
  </a>

  <dialog class="resume-dialog" id="resume-dialog" aria-labelledby="resume-title">
    <section class="resume-sheet">
      <header class="resume-toolbar">
        <h2 id="resume-title">My resume</h2>
        <div class="resume-tools">
          <a href="/Resume.pdf" download>Download PDF</a>
          <button class="resume-close" type="button" aria-label="Close resume" autofocus>×</button>
        </div>
      </header>
      <iframe class="resume-document" title="Gourish Chouhan’s resume" data-src="/Resume.pdf#view=FitH" ></iframe>
      <p class="resume-fallback">Preview not showing? <a href="/Resume.pdf" target="_blank" rel="noopener noreferrer">Open the PDF directly ↗</a></p>
    </section>
  </dialog>
</Layout>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('#resume-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('#resume-dialog');
  const frame = document.querySelector<HTMLIFrameElement>('.resume-document');
  const closeButton = document.querySelector<HTMLButtonElement>('.resume-close');
  const lightSwitch = document.querySelector<HTMLButtonElement>('#light-switch');

  if (trigger && lightSwitch) {
    // Without JavaScript the original resume link remains available.
    document.documentElement.classList.add('light-ready');
    trigger.inert = true;
    lightSwitch.hidden = false;
    let lightOn = false;
    let cordAnimation: Animation | undefined;
    const cord = lightSwitch.querySelector<SVGGElement>('.pull-cord')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pull = 0;
    let sway = 0;
    let pointer: { id: number; x: number; y: number } | undefined;
    function settleCord() {
      cordAnimation?.cancel();
      cord.style.transform = '';
      if (!motion.matches) {
        // A damped spring returns the cord to rest, with diminishing pendulum sway.
        const stretch = Math.max(pull, 12);
        const angle = sway || 5;
        const frames = Array.from({ length: 61 }, (_, i) => {
          const t = i / 60;
          const decay = Math.exp(-6 * t);
          return { transform: i === 60 ? 'rotate(0deg) scaleY(1)' :
            `rotate(${angle * decay * Math.cos(16 * t)}deg) scaleY(${1 + stretch / 125 * decay * Math.cos(20 * t)})` };
        });
        cordAnimation = cord.animate(frames, { duration: 1100, easing: 'linear' });
      }
      pull = sway = 0;
    }
    lightSwitch.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      pointer = { id: event.pointerId, x: event.clientX, y: event.clientY };
      cordAnimation?.cancel();
      lightSwitch.setPointerCapture(event.pointerId);
    });
    lightSwitch.addEventListener('pointermove', (event) => {
      if (!pointer || event.pointerId !== pointer.id) return;
      pull = Math.min(30, Math.max(0, event.clientY - pointer.y) * 0.5);
      sway = Math.max(-12, Math.min(12, (pointer.x - event.clientX) * 0.15));
      if (!motion.matches) cord.style.transform = `rotate(${sway}deg) scaleY(${1 + pull / 125})`;
    });
    lightSwitch.addEventListener('pointerup', () => { pointer = undefined; });
    lightSwitch.addEventListener('pointercancel', () => { pointer = undefined; settleCord(); });
    lightSwitch.addEventListener('click', () => {
      lightOn = !lightOn;
      document.documentElement.classList.toggle('light-on', lightOn);
      trigger.inert = !lightOn;
      lightSwitch.setAttribute('aria-pressed', String(lightOn));
      lightSwitch.setAttribute('aria-label', lightOn ? 'Hide the detective' : 'Reveal the detective');
      settleCord();
    });
  }

  if (trigger && dialog && frame && closeButton) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let closing = false;
    let animation: Animation | undefined;

    // Measure both elements so the sheet grows from the mascot on any screen.
    function foldedTransform() {
      const source = trigger!.getBoundingClientRect();
      const sheet = dialog!.getBoundingClientRect();
      const x = source.left + source.width / 2 - (sheet.left + sheet.width / 2);
      const y = source.top + source.height / 2 - (sheet.top + sheet.height / 2);
      return `translate(${x}px, ${y}px) scale(0.08)`;
    }

    trigger.setAttribute('aria-label', 'Open my resume');
    trigger.setAttribute('aria-haspopup', 'dialog');
    trigger.setAttribute('aria-controls', 'resume-dialog');

    trigger.addEventListener('click', (event) => {
      // Preserve the link's normal behavior for explicit new-tab clicks.
      if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      if (dialog.open) return;
      if (!frame.hasAttribute('src')) frame.src = frame.dataset.src!;
      dialog.showModal();
      document.documentElement.classList.add('resume-open');
      if (!reducedMotion.matches) {
        animation = dialog.animate([
          { transform: foldedTransform(), opacity: 0 },
          { transform: 'translate(0, 0) scale(1)', opacity: 1 },
        ], { duration: 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
      }
    });

    async function closeResume() {
      if (closing || !dialog!.open) return;
      closing = true;
      animation?.cancel();
      if (!reducedMotion.matches) {
        animation = dialog!.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 1 },
          { transform: foldedTransform(), opacity: 0 },
        ], { duration: 220, easing: 'ease-in', fill: 'forwards' });
        await animation.finished.catch(() => {});
      }
      dialog!.close();
      animation?.cancel();
      document.documentElement.classList.remove('resume-open');
      trigger!.focus({ preventScroll: true });
      closing = false;
    }

    closeButton.addEventListener('click', closeResume);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeResume();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right ||
          event.clientY < bounds.top || event.clientY > bounds.bottom) closeResume();
    });
  }
</script>
