---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gourish Chouhan">
  <main class="relative z-10 flex flex-col items-center justify-center min-h-screen px-6 text-center select-none">
    <div class="space-y-4">
      <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-200 to-gray-500 hover:scale-105 transition-transform duration-500 ease-out">
        Gourish Chouhan
      </h1>
    </div>
  </main>
</Layout>
