---
import '../styles/home.css';
import EarthControl from "../components/EarthControl.astro";
import ResumeAccess from '../components/ResumeAccess.astro';
import { portfolio } from '../data/portfolio';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={portfolio.name}
  description="A sleek personal portfolio for Gourish Chouhan."
>
  <nav aria-label="Explore" class="world-link"><a href="/world/">Explore the world</a></nav>
  <main class="name-screen" aria-labelledby="page-title">
    <div class="intro-content">
      <h1 id="page-title">{portfolio.name}</h1>

      <div class="intro-actions" aria-label="More about Gourish">
        <button class="info-button" type="button" aria-label={`Job status: ${portfolio.status}`}>
          <span>Job</span>
          <span class="info-panel job-panel" aria-hidden="true">
            <span class="job-visual">
              <img class="job-image" src="/job-detective.webp" alt="" width="384" height="384" decoding="async" />
            </span>
            <span class="job-copy">{portfolio.status}</span>
          </span>
        </button>

        <EarthControl />
      </div>
    </div>
  </main>
  <ResumeAccess />
</Layout>
